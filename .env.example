# =====================================================================
# TrazaPulso — credenciales y configuración (PLANTILLA)
# Copia este archivo como ".env" y llena los valores.
# El .env está protegido: no se puede abrir desde el navegador y no se incluye en los respaldos.
# =====================================================================

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trazapulso
DB_USER=root
DB_PASS=

# --- GLPI (API REST) ---
# Dirección de tu GLPI (con o sin /apirest.php al final)
GLPI_URL=
# Configuración > General > API > "Clientes de la API" > Token de aplicación (app_token)
GLPI_APP_TOKEN=
# Mi configuración (perfil del usuario de integración) > Claves de acceso remoto > Token de API
GLPI_USER_TOKEN=
# true = validar el certificado HTTPS (recomendado). false solo si usan certificado interno/autofirmado
GLPI_VERIFY_SSL=true
GLPI_TIMEOUT=20

# --- Respaldos ---
RESPALDO_DIR=C:/xampp/respaldos/trazapulso
RESPALDO_COPIA=
RESPALDO_DIAS=30
RESPALDO_AUTO_HORAS=24
MYSQL_BIN=C:/xampp/mysql/bin
